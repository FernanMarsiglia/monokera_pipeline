# =============================================================================
# SpaceNews Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Bucket
S3_BUCKET=monokera-bucket

# SNS Alerting
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:311048569989:spacenews-pipeline-alerts

# IAM Role for Redshift to read S3
REDSHIFT_IAM_ROLE=arn:aws:iam::311048569989:role/RedshiftS3ReadRole

# -----------------------------------------------------------------------------
# Redshift Configuration
# -----------------------------------------------------------------------------
REDSHIFT_HOST=monokera-pipeline.311048569989.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_DATABASE=dev
REDSHIFT_PORT=5439
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your_password_here

# Redshift Schemas
REDSHIFT_SCHEMA_STG=stg
REDSHIFT_SCHEMA_CORE=core

# -----------------------------------------------------------------------------
# SpaceNews API Configuration
# -----------------------------------------------------------------------------
SPACENEWS_API_BASE_URL=https://api.spaceflightnewsapi.net/v4

# Rate Limiting (requests per second)
RATE_LIMIT_PER_SECOND=10

# Pagination
PAGE_SIZE=100
MAX_PAGES=0  # 0 = no limit, follow 'next' until null

# Retry Configuration
MAX_RETRIES=5
RETRY_BACKOFF_BASE=1.5
REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# Pipeline Configuration
# -----------------------------------------------------------------------------

# Bronze Layer (S3)
BRONZE_PREFIX=data/bronze
BRONZE_METADATA_PREFIX=data/bronze/_meta

# Silver Layer (S3)
SILVER_PREFIX=data/silver
SILVER_QUARANTINE_PREFIX=data/silver/quarantine

# Gold Layer (S3)
GOLD_PREFIX=data/gold
GOLD_ENRICHED_PREFIX=data/gold/content_enriched
GOLD_TRENDS_PREFIX=data/gold/trends

# Glue Job Names
GLUE_JOB_CLEAN_DEDUP=spacenews-01-clean-dedup
GLUE_JOB_ENRICH=spacenews-02-enrich-topics-entities
GLUE_JOB_TRENDS=spacenews-03-trends-aggregations

# Glue Configuration
GLUE_VERSION=4.0
GLUE_WORKER_TYPE=G.1X
GLUE_NUMBER_OF_WORKERS=2

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
JSON_LOGGING=true

# -----------------------------------------------------------------------------
# Airflow Configuration (for local development)
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/opt/airflow/plugins

# Airflow Variables (also set via UI or CLI)
AIRFLOW_VAR_AWS_REGION=us-east-1
AIRFLOW_VAR_S3_BUCKET=monokera-bucket
AIRFLOW_VAR_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:311048569989:spacenews-pipeline-alerts

# -----------------------------------------------------------------------------
# Data Quality Thresholds
# -----------------------------------------------------------------------------
DQ_MIN_RECORDS_PER_RUN=10
DQ_MAX_INVALID_PERCENTAGE=5.0
DQ_MAX_DUPLICATE_PERCENTAGE=10.0
DQ_FRESHNESS_HOURS=24

# -----------------------------------------------------------------------------
# Alert Configuration
# -----------------------------------------------------------------------------
ALERT_ON_EXTRACTION_FAILURE=true
ALERT_ON_GLUE_JOB_FAILURE=true
ALERT_ON_DATA_QUALITY_ISSUE=true
ALERT_ON_THRESHOLD_BREACH=true
ALERT_ON_PIPELINE_SUCCESS=false  # Set to true if you want success alerts

# Alert Dry Run (set to true for testing without sending real alerts)
ALERT_DRY_RUN=false

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production

# Dry run mode (no S3 writes, no alerts)
DRY_RUN=false
